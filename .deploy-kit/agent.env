# Цель: агент, который собирает данные для страницы.

APP=status-agent
ROOT=/opt/status-agent
ARTIFACT_DIR=stage
UNIT=status-agent.service
OWNER=root:status
GOARCH=arm64

# Кавычки ОДИНАРНЫЕ: подстановка должна случиться при сборке, а не при чтении
# этого файла — иначе переменные окажутся пустыми.
BUILD_CMD='rm -rf stage && mkdir -p stage && cd agent && GOOS=linux GOARCH=${DEPLOY_GOARCH:-arm64} CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o ../stage/status-agent . && cd ..'

# Агент — oneshot по таймеру, а не постоянный сервис: HTTP-healthcheck к нему
# неприменим. Что он жив, видно по свежести данных на самой странице.
NEIGHBOURS=status.samoy.love

KEEP=5
WRITE_VERSION_FILE=0
