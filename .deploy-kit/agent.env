# Цель: агент, который собирает данные для страницы.

APP=status-agent
ROOT=/opt/status-agent
ARTIFACT_DIR=stage
UNIT=status-agent.service
OWNER=root:status
GOARCH=arm64

# Кавычки ОДИНАРНЫЕ: подстановка должна случиться при сборке, а не при чтении
# этого файла — иначе переменные окажутся пустыми.
# В артефакт кладём и конфиг проверок: он живёт в git рядом с кодом, и
# отдельная копия в /etc неизбежно отстаёт. Так и вышло — правки признаков
# состояния уехали на прод, а конфиг там остался прошлогодний, и половина
# работы была инертна.
# Юниты едут тем же артефактом (deploy-kit, install_units): раньше они
# лежали в git, а на сервер попадали руками, и файл в репозитории с файлом
# на машине расходились молча. Ровно из-за этого агент читал конфиг по
# пути, которого в установленном юните не было.
BUILD_CMD='rm -rf stage && mkdir -p stage/systemd && cd agent && GOOS=linux GOARCH=${DEPLOY_GOARCH:-arm64} CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o ../stage/status-agent . && cd .. && cp config/status.json stage/status.json && cp deploy/systemd/status-agent.service deploy/systemd/status-agent.timer stage/systemd/'

# Агент — oneshot по таймеру, а не постоянный сервис: HTTP-healthcheck к нему
# неприменим. Что он жив, видно по свежести данных на самой странице.
NEIGHBOURS=status.samoy.love

KEEP=5
WRITE_VERSION_FILE=0

# NOTIFY=all (умолчание) осознанно: статус-страница не следит сама за собой —
# ни её, ни агента, ни бота нет в config/status.json. Заглушить успех здесь
# значит остаться вообще без новостей об их выкатке.
