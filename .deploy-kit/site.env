# Цель: статическая страница статуса.

APP=status-site
BUILD_CMD="npm ci && npm run build"
ARTIFACT_DIR=dist

# Данные агента лежат в /var/www/status/data — ВНЕ каталога релизов, поэтому
# выкатка страницы их не трогает и история проверок переживает деплой.
ROOT=/var/www/status
OWNER=ubuntu:ubuntu

NGINX_RELOAD=1
NGINX_DEST=/etc/nginx/sites-available/status.samoy.love.conf

HEALTH=https://status.samoy.love/
VERSION_URL=https://status.samoy.love/version.json

NEIGHBOURS=samoy.love,metro.samoy.love,snakes.samoy.love,launcher.samoy.love

KEEP=5

# NOTIFY=all (умолчание) осознанно: статус-страница не следит сама за собой —
# ни её, ни агента, ни бота нет в config/status.json. Заглушить успех здесь
# значит остаться вообще без новостей об их выкатке.
