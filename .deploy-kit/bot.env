# Цель: телеграм-бот статуса.

APP=samoylove-bot
ROOT=/opt/samoylove-bot
ARTIFACT_DIR=stage
UNIT=samoylove-bot.service
OWNER=root:samoylove-bot
GOARCH=arm64

# Кавычки ОДИНАРНЫЕ: подстановка должна случиться при сборке, а не при чтении
# этого файла — иначе переменные окажутся пустыми.
# Юнит едет тем же артефактом (deploy-kit, install_units) — см. agent.env.
BUILD_CMD='rm -rf stage && mkdir -p stage/systemd && cd bot && GOOS=linux GOARCH=${DEPLOY_GOARCH:-arm64} CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o ../stage/samoylove-bot . && cd .. && cp deploy/systemd/samoylove-bot.service stage/systemd/ && cp deploy/verify-bot.sh stage/verify'

# HEALTH нет и не будет: бот никуда не слушает — он сам ходит в Telegram
# длинным опросом, и HTTP-запросом с сервера его не проверить.
#
# Вместо этого в артефакт кладётся исполняемый verify (deploy/verify-bot.sh):
# выкатка запускает его после переключения, он гоняет `-selftest`, и бот
# отправляет владельцу сводку. Провал — откат. Флаг -selftest был написан
# ровно для этого и до сих пор не использовался нигде.

# Соседи проверяются после переключения: бот делит хост со статус-страницей,
# и выкатка не должна её задеть.
NEIGHBOURS=status.samoy.love

KEEP=5
WRITE_VERSION_FILE=0

# О РЕЛИЗАХ В ЭТОМ ХОЗЯЙСТВЕ РАССКАЗЫВАЕТ БОТ, А НЕ CI — И ЭТО РОВНО ЭТА ЦЕЛЬ.
# Полное объяснение — в site.env, здесь коротко: бот есть в config/status.json
# отдельной сборкой (проект «Статус», симлинк /opt/samoylove-bot/current), смену
# своей версии он видит через агента и объявляет о ней сам. Уведомление из
# выкатки было бы дословным дубликатом того, что через минуту напишет он.
NOTIFY=never
