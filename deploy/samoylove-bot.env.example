# Образец файла окружения бота. На сервере лежит как /etc/samoylove-bot/env
# с правами 0600 и владельцем root — значения в репозиторий не попадают.
#
#   install -d -m 0755 /etc/samoylove-bot
#   install -m 0600 /dev/null /etc/samoylove-bot/env
#   # дальше вписать значения руками
#
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=

# Кому отвечать и кому слать уведомления. Всё, что приходит из других чатов,
# бот игнорирует молча.
TELEGRAM_CHAT_ID=

# Имя бота без «@». Нужно, только чтобы в группе отличать обращение к нам
# от обращения к другому боту; в личке можно не заполнять.
TELEGRAM_BOT_USERNAME=

# Необязательные настройки (значения ниже — умолчания).
# Как часто напоминать, что сервис всё ещё лежит.
#REMIND_INTERVAL=15m
# Как часто перечитывать данные агента.
#WATCH_INTERVAL=30s
# С какого возраста данные агента считаются устаревшими: если агент замолчал,
# все проверки в файле остаются зелёными, и об этом надо сообщить отдельно.
#STALE_AFTER=5m
