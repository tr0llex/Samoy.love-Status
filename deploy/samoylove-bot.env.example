# Единственное место настроек бота. Ставится в /etc/samoylove-bot/env
# с правами 0600 и владельцем root: systemd читает файл до смены пользователя,
# поэтому самому боту доступ к секретам не нужен.
#
# Обязательное.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Имя бота без «@». Нужно, чтобы в группе с несколькими ботами не отвечать
# на «/status@другой_бот».
TELEGRAM_BOT_USERNAME=samoy_love_bot

# Где лежат данные агента и состояние самого бота. Значения ниже — умолчания,
# строки можно не задавать вовсе.
#DATA_DIR=/var/www/status/data
#STATE_FILE=/var/lib/samoylove-bot/state.json
#METRICS_FILE=/var/lib/node_exporter/textfile/samoylove-bot.prom

# Как часто перечитывать данные, напоминать о длящемся простое и с какого
# возраста считать данные агента несвежими.
#WATCH_INTERVAL=30s
#REMIND_INTERVAL=15m
#STALE_AFTER=5m

# Адреса страницы и мини-приложения. Пригодится, чтобы проверить сборку
# через туннель: Telegram открывает мини-приложение только по https.
#STATUS_URL=https://status.samoy.love/
#MINIAPP_URL=https://status.samoy.love/tg/
