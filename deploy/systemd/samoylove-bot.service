[Unit]
Description=Телеграм-бот статуса samoy.love
Documentation=https://status.samoy.love
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=samoylove-bot
Group=samoylove-bot

# Токен и chat id — только здесь. Файл принадлежит root с правами 0600:
# EnvironmentFile читает systemd до смены пользователя, поэтому самому боту
# доступ к секрету не нужен.
EnvironmentFile=/etc/samoylove-bot/env

# Путь через симлинк current: выкатка переключает его атомарно.
#
# Аргументов нет намеренно: все настройки бота живут в одном месте — в
# EnvironmentFile выше. Раньше половина задавалась здесь флагами, половина
# переменными, и по строке запуска нельзя было понять, что победит.
ExecStart=/opt/samoylove-bot/current/samoylove-bot

# Бот обязан пережить перезапуск: он же и есть канал, по которому владелец
# узнаёт о сбоях. Молчащий бот выглядит как «всё хорошо».
Restart=always
RestartSec=5

# Данные агента нужны только на чтение: бот их пересказывает, а не правит.
# Своё состояние (offset и история уведомлений) пишет в отдельный каталог,
# а метрики — в textfile для node_exporter. Второй путь легко забыть:
# ProtectSystem=strict не роняет запуск, а лишь отвечает «read-only file
# system» на запись, бот пишет это в журнал и работает дальше. Метрик при
# этом нет, и StatusBotStale молчит — метрика, которой нет, не устаревает.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
ReadOnlyPaths=/var/www/status/data
ReadWritePaths=/var/lib/samoylove-bot /var/lib/node_exporter/textfile

[Install]
WantedBy=multi-user.target
