[Unit]
Description=Агент статус-страницы samoy.love
Documentation=https://status.samoy.love
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=status
Group=status
# Путь через симлинк current: выкатка переключает его атомарно, и следующий
# запуск таймера подхватывает новую версию без правки юнита.
ExecStart=/opt/status-agent/current/status-agent -config /etc/status-agent/status.json -data /var/www/status/data

# Root не нужен: systemctl show читается любым пользователем, каталоги релизов
# открыты на чтение. Пишем строго в два каталога: данные страницы и .prom для
# node_exporter. Второй легко забыть — ProtectSystem=strict не роняет запуск,
# а лишь возвращает «read-only file system» при записи, и агент честно пишет
# это в журнал, продолжая работать. Метрик при этом нет, а правило
# StatusAgentStale молчит, потому что метрики, которой нет, не бывает старой.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/www/status/data /var/lib/node_exporter/textfile

# Обход всех проверок укладывается в секунды; если что-то залипло — лучше
# прибить, чем копить параллельные запуски раз в минуту.
TimeoutStartSec=90
