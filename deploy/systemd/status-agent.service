[Unit]
Description=Агент статус-страницы samoy.love
Documentation=https://status.samoy.love
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=status
Group=status
ExecStart=/usr/local/bin/status-agent -config /etc/status-agent/status.json -data /var/www/status/data

# Root не нужен: systemctl show читается любым пользователем, каталоги релизов
# открыты на чтение. Пишем строго в один каталог.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/www/status/data

# Обход всех проверок укладывается в секунды; если что-то залипло — лучше
# прибить, чем копить параллельные запуски раз в минуту.
TimeoutStartSec=90
