{
  "//": "Единый конфиг: его читают и серверный агент (agent/), и внешний пробер в GitHub Actions (scripts/probe.mjs). Порядок проектов = порядок на странице.",
  "projects": [
    {
      "id": "samoy",
      "title": "samoy.love",
      "subtitle": "Личная страница и витрина проектов",
      "url": "https://samoy.love",
      "accent": "oklch(0.78 0.16 195)",
      "checks": [
        {
          "id": "samoy",
          "name": "Сайт",
          "url": "https://samoy.love/",
          "expect": 200,
          "cert": "samoy.love"
        }
      ],
      "builds": [{ "title": "Сайт", "type": "file", "path": "/var/www/samoy.love/index.html" }]
    },
    {
      "id": "launcher",
      "title": "ChillHub",
      "subtitle": "Лаунчер игр: сайт, раздача сборок и админка",
      "url": "https://launcher.samoy.love",
      "accent": "oklch(0.75 0.15 55)",
      "checks": [
        {
          "id": "launcher",
          "name": "Сайт",
          "url": "https://launcher.samoy.love/",
          "expect": 200,
          "cert": "launcher.samoy.love"
        },
        {
          "id": "launcher-api",
          "name": "API манифестов",
          "note": "Через него лаунчер узнаёт о новых версиях",
          "url": "https://launcher.samoy.love/manifests/launcher/latest.json",
          "expect": 200
        },
        {
          "id": "launcher-admin",
          "name": "API админки",
          "note": "Публикация сборок и новостей",
          "url": "https://launcher.samoy.love/admin/api/health",
          "expect": 200
        }
      ],
      "units": [
        { "name": "chillhub-api.service", "title": "Публичный API" },
        { "name": "chillhub-admin.service", "title": "Админка" }
      ],
      "builds": [
        { "title": "Сайт", "type": "file", "path": "/var/www/site/index.html" },
        { "title": "Публичный API", "type": "file", "path": "/opt/chillhub/api" },
        { "title": "Админка", "type": "file", "path": "/opt/chillhub/admin" }
      ]
    },
    {
      "id": "snakes",
      "title": "Snakes",
      "subtitle": "Мультиплеерный захват территории",
      "url": "https://snakes.samoy.love",
      "accent": "oklch(0.85 0.2 130)",
      "checks": [
        {
          "id": "snakes-health",
          "name": "Игровой сервер",
          "note": "Без него матчи не идут",
          "url": "https://snakes.samoy.love/healthz",
          "expect": 200
        },
        {
          "id": "snakes",
          "name": "Клиент",
          "url": "https://snakes.samoy.love/",
          "expect": 200,
          "cert": "snakes.samoy.love"
        }
      ],
      "units": [{ "name": "snakes.service", "title": "Игровой сервер" }],
      "builds": [{ "title": "Сервер и клиент", "type": "release", "path": "/opt/snakes/current" }]
    },
    {
      "id": "metro",
      "title": "Hello Kitty Метро",
      "subtitle": "Офлайн-PWA со схемой московского метро",
      "url": "https://metro.samoy.love",
      "accent": "oklch(0.78 0.17 350)",
      "checks": [
        {
          "id": "metro",
          "name": "Сайт",
          "url": "https://metro.samoy.love/",
          "expect": 200,
          "cert": "metro.samoy.love"
        },
        {
          "id": "metro-sw",
          "name": "Service worker",
          "note": "Отвечает за офлайн-режим",
          "url": "https://metro.samoy.love/kitty-metro-sw.js",
          "expect": 200
        }
      ],
      "builds": [{ "title": "Сайт", "type": "file", "path": "/var/www/metro/index.html" }]
    }
  ]
