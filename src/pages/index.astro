---
import Layout from '../layouts/Layout.astro';

// Данные пишет агент на том же сервере (agent/), раз в минуту, рядом со
// страницей — поэтому путь относительный и без задержек CDN.
const DATA_URL = import.meta.env.PUBLIC_DATA_URL ?? '/data/summary.json';
---

<Layout
  title="Статус сервисов — samoy.love"
  description="Доступность сайтов и сервисов samoy.love: текущий статус, аптайм за 90 дней, история инцидентов."
>
  <main class="page container" data-src={DATA_URL}>
    <header class="masthead">
      <p class="mono kicker">~/status</p>
      <h1>Статус сервисов</h1>
      <p class="lede">
        Проверки раз в минуту. Страница живёт на том же сервере, что и сервисы, — если он
        недоступен, она тоже не откроется; на этот случай отдельная внешняя проверка сообщает
        о недоступности в Telegram.
      </p>
    </header>

    <noscript>
      <p class="noscript">
        Страница рисует данные через JavaScript. Без него остаётся
        <a href={DATA_URL}>исходный JSON проверок</a> — там то же самое, только без оформления.
      </p>
    </noscript>

    <!-- Главный экран: одно крупное утверждение и три числа под ним. Всё
         остальное на странице — подробности к этой строке. -->
    <section class="hero loading" id="hero" aria-live="polite">
      <p class="hero-state">
        <span class="hero-dot" aria-hidden="true"></span>
        <span id="hero-title">Загружаю данные…</span>
      </p>
      <p class="hero-note" id="hero-note"></p>

      <dl class="facts">
        <div class="fact">
          <dt>ключевых проверок в норме</dt>
          <dd class="mono" id="fact-checks">—</dd>
        </div>
        <div class="fact">
          <dt>аптайм ключевых за 90 дней</dt>
          <dd class="mono" id="fact-uptime">—</dd>
        </div>
        <div class="fact">
          <dt>последняя проверка</dt>
          <dd class="mono" id="fact-updated">—</dd>
        </div>
      </dl>
    </section>

    <!-- Что сломано — выше всего остального. Ради этого блока страницу и
         открывают, и искать его среди зелёных строк не должно быть нужно. -->
    <section class="alerts" id="alerts" hidden aria-labelledby="alerts-h">
      <h2 class="sr-only" id="alerts-h">Что сейчас не работает</h2>
      <ul class="alert-list" id="alert-list" role="list"></ul>
    </section>

    <div id="projects"></div>

    <section class="block" id="incidents-block" hidden>
      <h2 class="block-h">Последние инциденты</h2>
      <ul class="incidents" id="incidents" role="list"></ul>
    </section>

    <footer class="foot">
      <a href="https://samoy.love">← samoy.love</a>
      <span class="mono">проверки раз в минуту · история за 90 дней</span>
    </footer>
  </main>
</Layout>

<script>
  // Типы и вся логика «что означают эти данные» — в общем модуле: тем же
  // кодом пользуется мини-приложение в Telegram, и разъезжаться вердикты
  // не должны.
  import {
    type CertState,
    type Build,
    type Check,
    type Day,
    type Project,
    type Summary,
    dayClass,
    duration,
    elapsed,
    esc,
    exactAttr,
    fmtDate,
    fmtMs,
    fmtPct,
    heroState,
    HERO_TEXT,
    mskExact,
    relTime,
    safeColor,
    safeUrl,
    troubles,
    uptimeOf,
  } from '../lib/status';

  // Путь к данным приходит атрибутом, а не через define:vars: с define:vars
  // Astro обязан отдать скрипт инлайном и без обработки, то есть без
  // минификации и без отдельного файла с вечным кэшем.
  const DATA_URL = document.querySelector('main')?.dataset.src ?? '/data/summary.json';
  const REFRESH_MS = 60_000;

  // Элементы каркаса заданы в разметке этой же страницы: если какого-то нет,
  // это опечатка в вёрстке, и молча рисовать половину страницы хуже, чем
  // упасть с внятным сообщением в консоли.
  function el(id: string): HTMLElement {
    const node = document.getElementById(id);
    if (!node) throw new Error(`нет элемента #${id}`);
    return node;
  }

  function bars(input: (Day | null)[] | null | undefined) {
    // Ровно 90 ячеек по календарю приходят от агента: дырка в середине это
    // сутки без замеров, а не повод сдвинуть историю влево. Если поля нет
    // вовсе — рисуем пустую шкалу, а не схлопываем строку: у проверки,
    // добавленной сегодня, разметка должна выглядеть так же, как у всех.
    const cells: (Day | null)[] = input?.length
      ? input
      : Array.from({ length: 90 }, () => null);
    const known = cells.filter((d) => d && d.total).length;
    const bad = cells.filter((d) => d && d.total && d.up < d.total).length;

    // Подпись для чтения с экрана: 90 отдельных ячеек ему бесполезны, а одна
    // фраза с числом плохих дней — ровно то, что из шкалы считывает глаз.
    // «Данных нет» и «сбоев не было» — разные вещи: в первый день жизни
    // проверки пустая шкала не означает, что всё было хорошо.
    const label = !known
      ? 'Истории пока нет'
      : bad === 0
        ? `Сбоев не было, история за ${known} дн. из 90`
        : `Дней со сбоями: ${bad} из ${known} с данными`;

    const html = cells
      .map((d) => {
        const title = d
          ? `${d.d}: ${fmtPct((d.up / d.total) * 100)} · ${d.avgMs} мс`
          : 'нет данных';
        return `<i class="bar ${dayClass(d)}" title="${esc(title)}"></i>`;
      })
      .join('');

    return `<div class="bars" role="img" aria-label="${esc(label)}">${html}</div>`;
  }

  function sparkline(values: (number | null)[] | null | undefined) {
    const pts = (values ?? []).filter((v): v is number => typeof v === 'number');
    if (pts.length < 2) return '';
    const max = Math.max(...pts, 1);
    const step = 100 / (pts.length - 1);
    const d = pts.map((v, i) => `${i * step},${24 - (v / max) * 20}`).join(' ');
    return `<svg class="spark" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true">
      <polyline points="${d}" fill="none" stroke="currentColor" stroke-width="1.5"
        vector-effect="non-scaling-stroke" stroke-linejoin="round" />
    </svg>`;
  }

  // ------------------------------------------------------------------ проверка

  // Плашка сертификата.
  //
  // «Истёк» и «не смогли проверить» — разные новости. Раньше любая беда давала
  // отсутствие плашки, и сертификат молча исчезал ровно тогда, когда о нём
  // важнее всего знать.
  function certBadge(days: number | null | undefined, state?: CertState | null) {
    if (state === 'expired') {
      return `<span class="chip cert down" title="Сертификат просрочен">TLS истёк</span>`;
    }
    if (state === 'invalid') {
      return `<span class="chip cert down" title="Сертификат не проходит проверку цепочки">TLS негоден</span>`;
    }
    if (state === 'unreachable') {
      return `<span class="chip cert unknown" title="До сертификата не достучались — это не значит, что он в порядке">TLS ?</span>`;
    }
    if (days == null) return '';
    const cls = days <= 7 ? 'down' : days <= 21 ? 'partial' : 'ok';
    return `<span class="chip cert ${cls}" title="Срок действия TLS-сертификата">TLS ${days} дн.</span>`;
  }

  function checkRow(s: Check) {
    // uptime приходит null, пока по проверке нет ни одного замера, — а такое
    // бывает ровно в тот день, когда проверку добавили.
    const u = s.uptime ?? { d1: null, d7: null, d90: null };
    const since =
      s.status === 'down'
        ? `недоступен ${elapsed(s.since)}`
        : s.status === 'slow'
          ? `медленно ${elapsed(s.since)}`
          : `стабильно ${elapsed(s.since)}`;

    // Покрытие истории: «100% за 90 дней» по двум наблюдавшимся суткам —
    // не то же самое, что честные девяносто, и молчать об этом нельзя.
    const cov =
      s.coverage != null && s.coverage < 90
        ? `<span class="cov" title="За остальные сутки замеров нет — окно ещё не набралось">данные за ${s.coverage} дн. из 90</span>`
        : '';

    return `
      <article class="chk ${s.status}${s.critical ? '' : ' aux'}">
        <div class="chk-head">
          <span class="dot" aria-hidden="true"></span>
          <span class="chk-id">
            <a class="chk-name" href="${safeUrl(s.url)}" target="_blank" rel="noopener noreferrer">${esc(s.name)}</a>
            ${s.steps ? `<span class="chk-tag" title="Проверка из ${s.steps} шагов подряд, а не один запрос">сценарий</span>` : ''}
            ${s.critical ? '' : '<span class="chk-tag" title="Падение не роняет вердикт проекта">второстепенная</span>'}
            ${s.note ? `<span class="chk-note">${esc(s.note)}</span>` : ''}
          </span>
          <span class="chk-meta">
            ${certBadge(s.certDays, s.certState)}
            <span class="lat mono" title="Время ответа при последней проверке${s.slowMs ? `; порог ${s.slowMs} мс` : ''}">${fmtMs(s.ms)}</span>
            ${sparkline(s.spark)}
          </span>
        </div>

        ${bars(s.days)}

        <div class="chk-foot mono">
          <span class="up-set">
            <span>24 ч <b>${fmtPct(u.d1)}</b></span>
            <span>7 дн <b>${fmtPct(u.d7)}</b></span>
            <span>90 дн <b>${fmtPct(u.d90)}</b></span>
            ${cov}
          </span>
          <span class="since"${exactAttr(s.since)}>${esc(since)}</span>
        </div>
        ${s.error ? `<p class="chk-err mono">${esc(s.error)}</p>` : ''}
      </article>`;
  }

  // ------------------------------------------------------------------ проект

  // Нижняя полоса карточки: службы и что именно сейчас выкачено.
  // Показываем только то, что не стыдно показать снаружи: состояние службы,
  // версию и дату сборки. Диск, память и счётчики рестартов — не сюда.
  function infoStrip(p: Project) {
    const units = (p.units ?? []).map((unit) => {
      const since = unit.since ? ` · с ${fmtDate(unit.since)}` : '';
      const state = unit.active ? 'работает' : unit.state || 'остановлена';
      return `<li class="info-item">
        <span class="dot ${unit.active ? 'up' : 'down'}" aria-hidden="true"></span>
        <span class="i-title">${esc(unit.title || unit.name)}</span>
        <span class="mono i-val"${exactAttr(unit.since)}>${esc(state)}${esc(since)}</span>
      </li>`;
    });

    const builds = (p.builds ?? []).map(buildRow);

    if (!units.length && !builds.length) return '';
    return `
      <div class="info">
        ${units.length ? `<div class="info-col"><p class="mono info-h">службы</p><ul role="list">${units.join('')}</ul></div>` : ''}
        ${builds.length ? `<div class="info-col"><p class="mono info-h">выкачено</p><ul role="list">${builds.join('')}</ul></div>` : ''}
      </div>`;
  }

  // Текущая версия плюс, если история накопилась, раскрывающийся список
  // предыдущих. Свёрнут по умолчанию: на вопрос «что сейчас крутится»
  // отвечает первая строка, а changelog нужен реже и по запросу.
  function buildRow(b: Build) {
    const now = `<span class="mono i-val"${exactAttr(b.at)}>${
      b.version ? `<b>${esc(b.version)}</b> · ` : ''
    }${b.at ? esc(fmtDate(b.at)) : '—'}</span>`;

    // Первая запись истории — это и есть текущая версия, её уже показали.
    const past = (b.history ?? []).slice(1);
    if (!past.length) {
      return `<li class="info-item">
        <span class="i-title">${esc(b.title)}</span>
        ${now}
      </li>`;
    }

    const rows = past
      .map(
        (r) => `<li class="rel">
          <span class="mono rel-v">${esc(r.version)}</span>
          <span class="mono rel-at"${exactAttr(r.seen)}>${esc(fmtDate(r.seen))}</span>
        </li>`,
      )
      .join('');

    return `<li class="info-item has-log">
      <details class="log">
        <summary class="log-head">
          <span class="i-title">${esc(b.title)}</span>
          ${now}
          <span class="chev sm" aria-hidden="true"></span>
        </summary>
        <ol class="rel-list" role="list">${rows}</ol>
        <p class="rel-hint mono">время — когда версия впервые увидена работающей</p>
      </details>
    </li>`;
  }

  // Аптайм проекта — тем же правилом, что и общий: только критичные проверки.
  const projectUptime = (p: Project) => uptimeOf(p.checks);

  // Раскрытыми держим только проблемные проекты: когда всё работает, десять
  // строк со стопроцентным аптаймом — это шум, за которым не видно случая,
  // когда он всё-таки не стопроцентный. Ручное раскрытие переживает
  // перерисовку, иначе раз в минуту всё схлопывалось бы под руками.
  const manuallyToggled = new Map<string, boolean>();

  function projectCard(p: Project) {
    const label =
      p.status === 'up' ? 'всё работает' : p.status === 'down' ? 'не работает' : 'частичный сбой';
    const badge = p.status === 'degraded' ? 'partial' : p.status;
    // Раскрываем и там, где сломано только второстепенное: вердикт это не
    // роняет, но человек должен увидеть, что именно.
    const trouble = p.status !== 'up' || !!p.auxDown || !!p.auxSlow;
    const open = manuallyToggled.get(p.id) ?? trouble;
    const up90 = projectUptime(p);

    // Второстепенные проблемы называем отдельной плашкой, а не подмешиваем в
    // счётчик критичных: иначе непонятно, задеты пользователи или нет.
    const auxCount = (p.auxDown ?? 0) + (p.auxSlow ?? 0);
    const aux = auxCount
      ? `<span class="chip aux" title="Не влияет на доступность для пользователей">+${auxCount} второстеп.</span>`
      : '';

    return `
      <details class="proj ${p.status}" data-id="${esc(p.id)}" style="--p-accent: ${safeColor(p.accent)}"${open ? ' open' : ''}>
        <summary class="proj-head">
          <span class="dot" aria-hidden="true"></span>
          <span class="proj-id">
            <span class="proj-name">${esc(p.title)}</span>
            ${p.subtitle ? `<span class="proj-sub">${esc(p.subtitle)}</span>` : ''}
          </span>
          <span class="proj-num mono">
            <b>${fmtPct(up90)}</b>
            <small>90 дней</small>
          </span>
          ${aux}
          <span class="chip ${badge}">${p.up}/${p.total} · ${label}</span>
          <span class="chev" aria-hidden="true"></span>
        </summary>
        <div class="proj-body">
          <p class="proj-link">
            <a href="${safeUrl(p.url)}" target="_blank" rel="noopener noreferrer">${esc(p.url.replace(/^https?:\/\//, ''))} ↗</a>
          </p>
          <div class="chk-list">${p.checks.map(checkRow).join('')}</div>
          ${infoStrip(p)}
        </div>
      </details>`;
  }

  // ------------------------------------------------------------------ отрисовка

  let latest: Summary | null = null;


  /** Обновляет только то, что зависит от текущего времени, — без перерисовки. */
  function refreshClock() {
    if (!latest) return;
    const state = heroState(latest);
    el('hero').className = `hero ${state}`;
    el('hero-title').textContent = HERO_TEXT[state];
    const updated = el('fact-updated');
    updated.textContent = relTime(latest.updated);
    updated.title = mskExact(latest.updated);
    el('hero-note').textContent =
      state === 'stale'
        ? `Агент не обновлял данные ${elapsed(latest.updated)}. Ниже — последнее, что он успел записать; сейчас всё может быть иначе.`
        : state === 'aux'
          ? 'Задеты только второстепенные проверки — на пользователей это не влияет.'
          : '';
  }

  function render(data: Summary) {
    latest = data;

    const checks = data.projects.flatMap((p) => p.checks);
    // В счётчике на главном экране — критичные проверки: он отвечает на
    // вопрос «сколько из того, чем пользуются, сейчас в порядке».
    const crit = checks.filter((c) => c.critical);
    const okCount = crit.filter((c) => c.status !== 'down').length;
    el('fact-checks').textContent = `${okCount} / ${crit.length}`;
    el('fact-uptime').textContent = fmtPct(uptimeOf(checks));

    refreshClock();

    // Порядок в списке — по тяжести для пользователя: сначала недоступное
    // критичное, потом медленное, потом второстепенное. Второстепенное
    // показываем всегда — вердикт оно не роняет, но знать о нём надо.
    const bad = troubles(data);
    const alerts = el('alerts');
    alerts.hidden = bad.length === 0;
    if (bad.length) {
      el('alert-list').innerHTML = bad
        .map(({ p, c }) => {
          const tone = c.status === 'down' ? (c.critical ? 'down' : 'aux') : 'slow';
          const what = c.status === 'down' ? 'недоступен' : 'отвечает медленно';
          return `<li class="alert ${tone}">
            <span class="dot ${c.status === 'down' ? 'down' : 'slow'}" aria-hidden="true"></span>
            <span class="alert-what">
              <b>${esc(p.title)} · ${esc(c.name)}</b>
              ${
                // impact описывает падение («сайт не открывается»), поэтому у
                // медленной проверки он был бы ложью: сайт открывается, просто
                // ждать дольше. Там достаточно текста про порог.
                c.impact && c.status === 'down'
                  ? `<span class="alert-impact">${esc(c.impact)}</span>`
                  : ''
              }
              <span class="alert-why mono">${esc(c.error || what)}</span>
            </span>
            <span class="alert-since mono"${exactAttr(c.since)}>${esc(what)} ${esc(elapsed(c.since))}</span>
          </li>`;
        })
        .join('');
    }

    el('projects').innerHTML = data.projects.map(projectCard).join('');

    const list = data.incidents ?? [];
    el('incidents-block').hidden = list.length === 0;
    if (list.length) {
      el('incidents').innerHTML = list
        .map((i) => {
          const how = i.end
            ? i.durationMs != null
              ? duration(i.durationMs)
              : '—'
            : 'продолжается';
          return `<li class="incident ${i.end ? 'closed' : 'open'}">
            <span class="mono when"${exactAttr(i.start)}>${esc(fmtDate(i.start))}</span>
            <span class="what"><b>${esc(i.name)}</b> — ${esc(i.reason)}</span>
            <span class="mono how-long">${esc(how)}</span>
          </li>`;
        })
        .join('');
    }
  }

  // ------------------------------------------------------------------ загрузка

  async function load() {
    try {
      const res = await fetch(DATA_URL, { cache: 'no-store' });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      render(await res.json());
    } catch (e) {
      latest = null;
      el('hero').className = 'hero down';
      el('hero-title').textContent = 'Не удалось загрузить данные проверок';
      el('hero-note').textContent = e instanceof Error ? e.message : String(e);
      el('fact-updated').textContent = '—';
    }
  }

  // Раскрытие/сворачивание проекта запоминаем: событие toggle не всплывает,
  // поэтому слушаем на стадии перехвата.
  el('projects').addEventListener(
    'toggle',
    (ev) => {
      const node = ev.target;
      if (node instanceof HTMLDetailsElement && node.dataset.id) {
        manuallyToggled.set(node.dataset.id, node.open);
      }
    },
    true,
  );

  // «Проверено N назад» стареет само по себе — его надо пересчитывать чаще,
  // чем ходить за данными.
  setInterval(refreshClock, 15_000);

  // В скрытой вкладке обновляться незачем; зато при возвращении к ней данные
  // нужны сразу, а не через минуту.
  setInterval(() => {
    if (!document.hidden) load();
  }, REFRESH_MS);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) load();
  });

  load();
</script>

<style>
  .page { padding: clamp(2rem, 6vw, 4rem) 0 3rem; }

  /* ---------- шапка ---------- */
  .masthead { margin-bottom: 1.8rem; }
  .kicker { color: var(--accent); font-size: 0.78rem; margin: 0 0 0.7rem; letter-spacing: 0.02em; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.7rem); font-weight: 800; }
  .lede { color: var(--text-dim); margin: 0.7rem 0 0; max-width: 64ch; font-size: 0.94rem; }

  .noscript {
    margin: 0 0 1.5rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-raise);
    font-size: 0.9rem;
  }

  /* ---------- главный экран ---------- */
  .hero {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raise);
