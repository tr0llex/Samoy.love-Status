---
// Мини-приложение для Telegram: открывается кнопкой из бота прямо внутри
// мессенджера, без перехода в браузер.
//
// Это не копия страницы в уменьшенном виде. У полной страницы задача —
// рассказать всё; здесь экран телефона внутри чужого интерфейса, и на нём
// должно помещаться ровно то, за чем открывают: что сломано и когда
// проверяли. Подробности — на отдельном экране по тапу.
//
// Вёрстка своя, но вся логика «что означают данные» общая с большой
// страницей (src/lib/status.ts): расходиться вердикты не должны.
const DATA_URL = import.meta.env.PUBLIC_DATA_URL ?? '/data/summary.json';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Статус — samoy.love</title>
    <meta name="robots" content="noindex" />
    <!-- SDK отдаёт тему пользователя и кнопку «назад». Скрипт с домена
         Telegram — единственный внешний ресурс на этой странице. -->
    <script src="https://telegram.org/js/telegram-web-app.js" is:inline></script>
  </head>
  <body data-src={DATA_URL}>
    <main class="app">
      <section class="hero loading" id="hero">
        <p class="state"><span class="dot" id="hero-dot"></span><span id="hero-title">Загружаю…</span></p>
        <p class="note" id="hero-note"></p>
        <p class="meta"><span id="fact-checks">—</span> · <span id="fact-updated">—</span></p>
      </section>

      <ul class="alerts" id="alerts" hidden></ul>

      <div id="projects"></div>

      <section id="incidents-block" hidden>
        <h2>Последние инциденты</h2>
        <ul class="incidents" id="incidents"></ul>
      </section>

      <p class="foot">
        обновляется само · <a href="/" target="_blank" rel="noopener">полная версия</a>
      </p>
    </main>

    <script>
      import {
        type Check,
        type Project,
        type Summary,
        dayClass,
        duration,
        elapsed,
        esc,
        fmtDate,
        fmtMs,
        fmtPct,
        heroState,
        HERO_TEXT,
        relTime,
        safeColor,
        troubles,
        uptimeOf,
        worstDays,
      } from '../lib/status';

      const DATA_URL = document.body.dataset.src ?? '/data/summary.json';
      const REFRESH_MS = 30_000;

      // Telegram отдаёт цвета темы пользователя. Подхватываем их, чтобы
      // приложение не выглядело чужой вставкой в мессенджере; если открыли
      // не из Telegram, остаются значения из CSS.
      const tg = (window as any).Telegram?.WebApp;
      if (tg) {
        tg.ready();
        tg.expand();
      }

      function el(id: string): HTMLElement {
        const node = document.getElementById(id);
        if (!node) throw new Error(`нет элемента #${id}`);
        return node;
      }

      // Полоска за 30 дней: на экране телефона девяносто ячеек по 2px
      // сливаются в кашу, а месяц читается. Считается по худшей из критичных
      // проверок за сутки — тем же правилом, что и в боте.
      const STRIP_DAYS = 30;
      function strip(p: Project) {
        const cells = worstDays(p, STRIP_DAYS);
        if (!cells.some(Boolean)) return '';
        return `<div class="strip">${cells
          .map((d) => `<i class="c ${dayClass(d)}"></i>`)
          .join('')}</div>`;
      }

      function checkLine(c: Check) {
        const when = c.status === 'down' ? `недоступен ${elapsed(c.since)}` : fmtMs(c.ms);
        return `<li class="chk ${c.status}${c.critical ? '' : ' aux'}">
          <span class="dot"></span>
          <span class="nm">${esc(c.name)}${c.critical ? '' : ' <i class="tag">второстеп.</i>'}</span>
          <span class="val">${esc(when)}</span>
        </li>`;
      }

      function projectCard(p: Project) {
        const aux = (p.auxDown ?? 0) + (p.auxSlow ?? 0);
        return `<section class="proj ${p.status}" style="--a: ${safeColor(p.accent)}">
          <header>
            <span class="dot"></span>
            <b>${esc(p.title)}</b>
            <span class="cnt">${p.up}/${p.total}${aux ? ` +${aux}` : ''}</span>
          </header>
          ${strip(p)}
          <ul class="checks">${p.checks.map(checkLine).join('')}</ul>
        </section>`;
      }

      function render(data: Summary) {
        const state = heroState(data);
        el('hero').className = `hero ${state}`;
        el('hero-title').textContent = HERO_TEXT[state];
        el('hero-note').textContent =
          state === 'stale'
            ? `Агент молчит ${elapsed(data.updated)} — ниже последнее, что он успел записать.`
            : state === 'aux'
              ? 'Задеты только второстепенные проверки.'
              : '';

        const checks = data.projects.flatMap((p) => p.checks);
        const crit = checks.filter((c) => c.critical);
        el('fact-checks').textContent =
          `${crit.filter((c) => c.status !== 'down').length}/${crit.length} ключевых` +
          ` · аптайм ${fmtPct(uptimeOf(checks))}`;
        el('fact-updated').textContent = relTime(data.updated);

        const bad = troubles(data);
        el('alerts').hidden = bad.length === 0;
        el('alerts').innerHTML = bad
          .map(
            ({ p, c }) => `<li class="alert ${c.status === 'down' ? (c.critical ? 'down' : 'aux') : 'slow'}">
              <b>${esc(p.title)} · ${esc(c.name)}</b>
              ${c.impact && c.status === 'down' ? `<span class="imp">${esc(c.impact)}</span>` : ''}
              <span class="why">${esc(c.error || '')}</span>
            </li>`,
          )
          .join('');

        el('projects').innerHTML = data.projects.map(projectCard).join('');

        const list = data.incidents ?? [];
        el('incidents-block').hidden = list.length === 0;
        el('incidents').innerHTML = list
          .map(
            (i) => `<li>
              <span class="when">${esc(fmtDate(i.start))}</span>
              <span class="what">${esc(i.name)} — ${esc(i.reason)}</span>
              <span class="how">${esc(i.end && i.durationMs != null ? duration(i.durationMs) : i.end ? '—' : 'идёт')}</span>
            </li>`,
          )
          .join('');
      }

      async function load() {
        try {
          const res = await fetch(DATA_URL, { cache: 'no-store' });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          render(await res.json());
        } catch (e) {
          el('hero').className = 'hero down';
          el('hero-title').textContent = 'Данные не загрузились';
          el('hero-note').textContent = e instanceof Error ? e.message : String(e);
        }
      }

      setInterval(() => {
        if (!document.hidden) load();
      }, REFRESH_MS);
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) load();
      });
      load();
    </script>

    <style is:global>
      /* Цвета берём у Telegram, но с запасными значениями: приложение должно
         открываться и просто по ссылке в браузере. */
      :root {
        color-scheme: light dark;
        --bg: var(--tg-theme-bg-color, #17191c);
        --card: var(--tg-theme-secondary-bg-color, #212429);
        --fg: var(--tg-theme-text-color, #f2f3f5);
        --dim: var(--tg-theme-hint-color, #9aa0a6);
        --accent: var(--tg-theme-link-color, #4ea1d3);
        --line: color-mix(in srgb, var(--fg) 14%, transparent);

        --up: #3ddc84;
        --slow: #f5c451;
        --down: #f0604d;
        --none: color-mix(in srgb, var(--fg) 18%, transparent);
      }

      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font: 15px/1.45 system-ui, -apple-system, 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .app {
        padding: 12px 12px 24px;
        max-width: 560px;
        margin-inline: auto;
      }
      h2 {
        font-size: 14px;
        margin: 18px 0 8px;
      }
      a {
        color: var(--accent);
      }

      .dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--none);
        flex: none;
      }

      /* --- главный экран --- */
      .hero {
        background: var(--card);
        border-radius: 14px;
        padding: 14px;
        --tone: var(--dim);
      }
      .hero.up {
        --tone: var(--up);
      }
      .hero.aux,
      .hero.stale {
        --tone: var(--dim);
      }
      .hero.partial {
        --tone: var(--slow);
      }
      .hero.major,
      .hero.down {
        --tone: var(--down);
      }
      .hero .dot {
        background: var(--tone);
        width: 11px;
        height: 11px;
      }
      .state {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0;
        font-size: 19px;
        font-weight: 700;
        letter-spacing: -0.01em;
      }
      .note:empty {
        display: none;
      }
      .note {
        margin: 8px 0 0;
        color: var(--dim);
        font-size: 13px;
      }
      .meta {
        margin: 10px 0 0;
        color: var(--dim);
        font-size: 12.5px;
        font-variant-numeric: tabular-nums;
      }

      /* --- что сломано --- */
      .alerts {
        list-style: none;
        margin: 10px 0 0;
        padding: 0;
        display: grid;
        gap: 8px;
      }
      .alert {
        padding: 10px 12px;
        border-radius: 12px;
        background: var(--card);
        border-left: 3px solid var(--down);
        display: grid;
        gap: 2px;
      }
      .alert.slow {
        border-left-color: var(--slow);
      }
      .alert.aux {
        border-left-color: var(--none);
      }
      .alert .imp {
        font-size: 13.5px;
      }
      .alert .why {
        color: var(--dim);
        font-size: 12px;
        overflow-wrap: anywhere;
      }
      .alert .why:empty {
        display: none;
      }

      /* --- проекты --- */
      .proj {
        background: var(--card);
        border-radius: 12px;
        padding: 11px 12px;
        margin-top: 8px;
        border-left: 3px solid var(--a);
      }
      .proj header {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .proj.up header .dot {
        background: var(--up);
      }
      .proj.degraded header .dot {
        background: var(--slow);
      }
      .proj.down header .dot {
        background: var(--down);
      }
      .cnt {
        margin-left: auto;
        color: var(--dim);
        font-size: 12.5px;
        font-variant-numeric: tabular-nums;
      }

      .strip {
        display: flex;
        gap: 1.5px;
        height: 16px;
        margin: 9px 0 4px;
      }
      .strip .c {
        flex: 1;
        border-radius: 2px;
        background: var(--none);
      }
      .strip .up {
        background: var(--up);
      }
      .strip .g1 {
        background: color-mix(in srgb, var(--up) 55%, var(--slow));
      }
      .strip .g2 {
        background: var(--slow);
      }
      .strip .g3 {
        background: color-mix(in srgb, var(--slow) 40%, var(--down));
      }
      .strip .down {
        background: var(--down);
      }

      .checks {
        list-style: none;
        margin: 4px 0 0;
        padding: 0;
        display: grid;
        gap: 4px;
      }
      .chk {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13.5px;
      }
      .chk.up .dot {
        background: var(--up);
      }
      .chk.slow .dot {
        background: var(--slow);
      }
      .chk.down .dot {
        background: var(--down);
      }
      .chk.aux .nm {
        color: var(--dim);
      }
      .chk .val {
        margin-left: auto;
        color: var(--dim);
        font-size: 12px;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }
      .tag {
        font-size: 10.5px;
        color: var(--dim);
        font-style: normal;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0 5px;
      }

      /* --- инциденты --- */
      .incidents {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 6px;
      }
      .incidents li {
        background: var(--card);
        border-radius: 10px;
        padding: 8px 11px;
        font-size: 12.5px;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 8px;
        align-items: baseline;
      }
      .incidents .when,
      .incidents .how {
        color: var(--dim);
        white-space: nowrap;
      }

      .foot {
        margin: 18px 0 0;
        text-align: center;
        color: var(--dim);
        font-size: 12px;
      }
    </style>
  </body>
</html>
